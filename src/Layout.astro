---
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/600.css';
import { ClientRouter } from 'astro:transitions';

import '@/global.css';
import '@/styles.css';

interface Props {
    description: string;
    noindex?: boolean;
    title: string;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const { description, noindex, title } = Astro.props;
const ogImageUrl = `${Astro.site}og.png`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1" name="viewport" />
        <title>{title}</title>
        <meta content={description} name="description" />
        <meta content="Kevin Huang" name="author" />
        <meta content="#faf8f3" name="theme-color" />
        <meta content={noindex ? 'noindex, nofollow' : 'index, follow'} name="robots" />
        <link href={canonicalUrl} rel="canonical" />
        <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
        <link href="/favicon.png" rel="icon" type="image/png" />
        <meta content={title} property="og:title" />
        <meta content={description} property="og:description" />
        <meta content={ogImageUrl} property="og:image" />
        <meta content={canonicalUrl} property="og:url" />
        <meta content="Figure Zero Project" property="og:site_name" />
        <meta content="website" property="og:type" />
        <meta content="summary_large_image" name="twitter:card" />
        <meta content={title} name="twitter:title" />
        <meta content={description} name="twitter:description" />
        <meta content={ogImageUrl} name="twitter:image" />
        <script
            is:inline
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebSite',
                'author': {
                    '@type': 'Person',
                    'name': 'Kevin Huang',
                },
                'inLanguage': 'en',
                'name': 'Figure Zero Project',
                'url': Astro.site,
            })}
            type="application/ld+json"
        />
        <ClientRouter />
    </head>
    <body class="flex flex-col min-h-svh antialiased font-serif bg-cream text-charcoal">
        <slot />
    </body>
</html>

<script>
    import { initMotion } from '@lib/motion';

    document.addEventListener('astro:page-load', initMotion);
</script>

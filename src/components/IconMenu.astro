<svg
    class="size-6 pointer-events-none"
    aria-hidden="true"
    viewBox="0 0 24 24"
>
    <path class="icon-menu__stroke icon-menu__stroke--top fill-none stroke-[2] stroke-current origin-center" d="M4 6.6 C 9.4 6.1, 15 6.9, 20.1 6.4" />
    <path class="icon-menu__stroke fill-none stroke-[2] stroke-current opacity-[calc(1_-_var(--icon-menu-open,0))] origin-center" d="M3.9 12.2 C 9.2 12.5, 15.4 11.7, 20 12.1" />
    <path class="icon-menu__stroke icon-menu__stroke--bottom fill-none stroke-[2] stroke-current origin-center" d="M4.1 17.5 C 9 17.9, 15.2 17.2, 20.2 17.6" />
</svg>

<style>
    .icon-menu__stroke {
        stroke-linecap: round;
        transform-box: fill-box;
        transition:
            opacity var(--duration-fast) ease,
            transform var(--duration-fast) ease;
        vector-effect: non-scaling-stroke;
    }

    .icon-menu__stroke--bottom {
        transform: translateY(calc(var(--icon-menu-open, 0) * -5.55px)) rotate(calc(var(--icon-menu-open, 0) * -45deg));
    }

    .icon-menu__stroke--top {
        transform: translateY(calc(var(--icon-menu-open, 0) * 5.5px)) rotate(calc(var(--icon-menu-open, 0) * 45deg));
    }
</style>

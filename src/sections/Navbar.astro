---
import IconMenu from '@components/IconMenu.astro';
import IconTheme from '@components/IconTheme.astro';
import { ROUTES, THEME_KEY } from '@lib/constants';
---

<header class="navbar sticky top-0 z-50 h-(--header-height) border-b bg-cream-90 border-linen backdrop-blur-sm">
    <div class="shell grid grid-cols-[1fr_auto_1fr] items-center relative h-full max-md:flex max-md:justify-between">
        <a
            class="group after:-inset-x-2 after:-inset-y-4 after:absolute hover:text-taupe flex flex-none items-center justify-self-start relative gap-3 no-underline text-charcoal duration-(--duration-fast) ease-[ease] transition-[color]"
            aria-label="Figure Zero Project home"
            href="/"
        >
            <span class="navbar__logo group-active:translate-y-0.5 block size-8 bg-current mask-center mask-contain mask-no-repeat duration-(--duration-fast) ease-[ease] transition-[translate]" aria-hidden="true" />
            <span class="navbar__wordmark group-active:translate-y-0.5 font-display tracking-[0.02em] duration-(--duration-fast) ease-[ease] transition-[translate]">Figure Zero Project</span>
        </a>
        <nav
            id="navbar-menu"
            class="navbar__menu max-md:bg-cream max-md:border-b max-md:border-linen max-md:fixed max-md:inset-x-0 max-md:invisible max-md:opacity-0 max-md:pb-3 max-md:pt-2 max-md:top-(--header-height)"
            aria-label="Primary"
            data-nav-menu
        >
            <ul class="flex items-center gap-[clamp(16px,calc(12px+1.25vw),28px)] max-md:flex-col max-md:gap-0 max-md:items-stretch">
                {ROUTES.map(route => (
                    <li>
                        <a
                            class="navbar__link active:translate-y-0.5 after:-inset-x-2 after:-inset-y-4 after:absolute aria-[current=page]:border-b aria-[current=page]:border-charcoal aria-[current=page]:hover:border-taupe aria-[current=page]:pb-0.5 hover:text-taupe block relative font-sans no-underline text-[12px] tracking-[0.16em] uppercase text-charcoal duration-(--duration-fast) ease-[ease] transition-[border-color,color,translate] max-md:after:content-none max-md:aria-[current=page]:border-b-0 max-md:aria-[current=page]:decoration-1 max-md:aria-[current=page]:pb-4 max-md:aria-[current=page]:underline max-md:aria-[current=page]:underline-offset-6 max-md:px-(--shell-pad) max-md:py-4"
                            href={route.href}
                        >
                            {route.label}
                        </a>
                    </li>
                ))}
            </ul>
            <button
                class="navbar__theme active:translate-y-0.5 after:-inset-2 after:absolute hover:text-taupe absolute flex items-center justify-center right-(--shell-pad) top-1/2 size-8 text-charcoal -translate-y-1/2 duration-(--duration-fast) ease-[ease] transition-[color,translate] max-md:after:content-none max-md:justify-start max-md:px-(--shell-pad) max-md:py-4 max-md:size-auto max-md:static max-md:translate-y-0 max-md:w-full"
                aria-label="Dark theme"
                aria-pressed="false"
                data-theme-toggle
                type="button"
            >
                <IconTheme />
            </button>
        </nav>
        <button
            class="navbar__toggle active:translate-y-0.5 after:-inset-2 after:absolute aria-expanded:[--icon-menu-open:1] hover:text-taupe hidden items-center justify-center justify-self-end relative size-8 text-charcoal duration-(--duration-fast) ease-[ease] transition-[color,translate] max-md:flex"
            aria-controls="navbar-menu"
            aria-expanded="false"
            aria-label="Toggle navigation"
            data-nav-toggle
            type="button"
        >
            <IconMenu />
        </button>
    </div>
</header>

<style>
    .navbar__logo {
        mask-image: url('../images/logos/figure_zero.webp');
    }

    .navbar__wordmark {
        font-size: clamp(14px, calc(12.67px + 0.4167vw), 18px);
    }

    @media (max-width: 768px) {
        .navbar:has(.navbar__menu--open) {
            backdrop-filter: none;
            background: var(--color-cream);
        }

        .navbar::after {
            background: var(--color-charcoal-35);
            content: '';
            inset: var(--header-height) 0 0;
            opacity: 0;
            position: fixed;
            transition:
                opacity var(--duration-fast) ease,
                visibility 0s ease var(--duration-fast);
            visibility: hidden;
            z-index: -1;
        }

        .navbar:has(.navbar__menu--open)::after {
            opacity: 1;
            transition: opacity var(--duration-fast) ease;
            visibility: visible;
        }

        .navbar__menu {
            transition:
                opacity var(--duration-fast) ease,
                visibility 0s ease var(--duration-fast);
        }

        .navbar__menu--instant {
            transition: none;
        }

        .navbar__menu--open {
            opacity: 1;
            transition: opacity var(--duration-fast) ease;
            visibility: visible;
        }
    }
</style>

<script
    define:vars={{ themeKey: THEME_KEY }}
    is:inline
>
    let storedTheme;

    try {
        const raw = localStorage.getItem(themeKey);

        storedTheme = raw ? JSON.parse(raw).theme : null;
    } catch {
        storedTheme = null;
    }

    if (storedTheme === 'dark' || storedTheme === 'light') document.documentElement.dataset.theme = storedTheme;
</script>

<script>
    import { THEME_COLORS, THEME_KEY } from '@lib/constants';
    import { loadTheme, saveTheme } from '@lib/store';

    const DARK_QUERY = '(prefers-color-scheme: dark)';
    const FOCUSABLE_SELECTOR = 'a, button';
    const MENU_INSTANT_CLASS = 'navbar__menu--instant';
    const MENU_OPEN_CLASS = 'navbar__menu--open';
    const MOBILE_QUERY = '(max-width: 768px)';
    const NAVBAR_SELECTOR = '.navbar';
    const REDUCED_MOTION_QUERY = '(prefers-reduced-motion: reduce)';

    let controller: AbortController;
    let menu: HTMLElement | null;
    let menuToggle: HTMLButtonElement | null;
    let navbar: HTMLElement | null;
    let themeChoice: Theme | null;
    let themeToggle: HTMLButtonElement | null;

    function closeMenu(shouldRestoreFocus = false) {
        menu?.classList.remove(MENU_OPEN_CLASS);
        menuToggle?.setAttribute('aria-expanded', 'false');

        if (shouldRestoreFocus) menuToggle?.focus();
    }

    function getTheme(choice = getThemeChoice()) {
        return choice ?? (window.matchMedia(DARK_QUERY).matches ? 'dark' : 'light');
    }

    function getThemeChoice() {
        return themeChoice ?? loadTheme();
    }

    function handleKeyDown(event: KeyboardEvent) {
        if (!menu?.classList.contains(MENU_OPEN_CLASS)) return;

        if (event.key === 'Escape') {
            closeMenu(true);

            return;
        }

        if (event.key === 'Tab' && navbar) trapTabKey(event, navbar);
    }

    function handleMenuToggle() {
        if (menu?.classList.contains(MENU_OPEN_CLASS)) closeMenu(true);
        else openMenu();
    }

    function handleMobileChange(event: MediaQueryListEvent) {
        if (!event.matches) {
            closeMenu();

            return;
        }

        menu?.classList.add(MENU_INSTANT_CLASS);
        requestAnimationFrame(() => requestAnimationFrame(() => menu?.classList.remove(MENU_INSTANT_CLASS)));
    }

    function handleMouseDown(event: MouseEvent) {
        if (!menu?.classList.contains(MENU_OPEN_CLASS)) return;
        if (event.clientY < menu.getBoundingClientRect().bottom) return;

        const shouldRestoreFocus = menu.contains(document.activeElement);

        if (shouldRestoreFocus) event.preventDefault();

        closeMenu(shouldRestoreFocus);
    }

    function handleStorage(event: StorageEvent) {
        if (event.key !== THEME_KEY) return;

        themeChoice = loadTheme();
        syncTheme();
    }

    function handleThemeToggle() {
        const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';

        themeChoice = nextTheme;
        saveTheme(nextTheme);

        if (!document.startViewTransition || window.matchMedia(REDUCED_MOTION_QUERY).matches) {
            syncTheme();

            return;
        }

        document.startViewTransition(syncTheme);
    }

    function initNavbar() {
        const currentPath = normalizePath(window.location.pathname);

        controller?.abort();
        controller = new AbortController();
        navbar = document.querySelector<HTMLElement>(NAVBAR_SELECTOR);
        menu = navbar?.querySelector<HTMLElement>('[data-nav-menu]') ?? null;
        menuToggle = navbar?.querySelector<HTMLButtonElement>('[data-nav-toggle]') ?? null;
        themeToggle = navbar?.querySelector<HTMLButtonElement>('[data-theme-toggle]') ?? null;
        syncTheme();

        navbar?.querySelectorAll<HTMLAnchorElement>('.navbar__link').forEach((link) => {
            const linkPath = normalizePath(link.pathname);

            const isActive = linkPath === currentPath;

            if (isActive) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');

            link.addEventListener('click', () => closeMenu(), { signal: controller.signal });
        });

        document.addEventListener('keydown', handleKeyDown, { signal: controller.signal });
        document.addEventListener('mousedown', handleMouseDown, { signal: controller.signal });
        menuToggle?.addEventListener('click', handleMenuToggle, { signal: controller.signal });
        themeToggle?.addEventListener('click', handleThemeToggle, { signal: controller.signal });
        window.addEventListener('storage', handleStorage, { signal: controller.signal });
        window.matchMedia(DARK_QUERY).addEventListener('change', syncTheme, { signal: controller.signal });
        window.matchMedia(MOBILE_QUERY).addEventListener('change', handleMobileChange, { signal: controller.signal });
    }

    function normalizePath(path: string) {
        return path.replace(/\/$/, '') || '/';
    }

    function openMenu() {
        menu?.classList.add(MENU_OPEN_CLASS);
        menu?.querySelector('a')?.focus();
        menuToggle?.setAttribute('aria-expanded', 'true');
    }

    function syncTheme() {
        const choice = getThemeChoice();
        const themeColorMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

        const theme = getTheme(choice);

        if (choice) document.documentElement.dataset.theme = choice;
        else delete document.documentElement.dataset.theme;

        themeToggle?.setAttribute('aria-pressed', String(theme === 'dark'));

        if (themeColorMeta) themeColorMeta.content = THEME_COLORS[theme];
    }

    function trapTabKey(event: KeyboardEvent, container: HTMLElement) {
        const focusables = container.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR);

        const firstFocusable = focusables[0];
        const lastFocusable = focusables[focusables.length - 1];

        const edgeFocusable = event.shiftKey ? firstFocusable : lastFocusable;
        const wrapFocusable = event.shiftKey ? lastFocusable : firstFocusable;

        if (container.contains(document.activeElement) && document.activeElement !== edgeFocusable) return;

        event.preventDefault();
        wrapFocusable?.focus();
    }

    document.addEventListener('astro:page-load', initNavbar);
</script>

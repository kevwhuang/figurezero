---
import IconMenu from '@components/IconMenu.astro';
import IconTheme from '@components/IconTheme.astro';
import { ROUTES, THEME_KEY } from '@lib/constants';
---

<header class="navbar sticky top-0 z-50 border-b border-linen">
    <div class="navbar__bar shell">
        <a
            class="navbar__brand flex items-center"
            aria-label="Figure Zero Project home"
            href="/"
        >
            <span class="navbar__logo block size-8" aria-hidden="true" />
            <span class="navbar__wordmark">Figure Zero Project</span>
        </a>
        <nav aria-label="Primary">
            <ul
                id="navbar-menu"
                class="navbar__menu flex items-center gap-[clamp(14px,calc(9.33px+1.46vw),28px)]"
                data-nav-menu
            >
                {ROUTES.map(route => (
                    <li>
                        <a
                            class="navbar__link"
                            href={route.href}
                        >
                            {route.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
        <div class="navbar__controls flex items-center gap-4">
            <button
                class="navbar__theme"
                aria-label="Dark theme"
                aria-pressed="false"
                data-theme-toggle
                type="button"
            >
                <IconTheme />
            </button>
            <button
                class="navbar__toggle"
                aria-controls="navbar-menu"
                aria-expanded="false"
                aria-label="Toggle navigation"
                data-nav-toggle
                type="button"
            >
                <IconMenu />
            </button>
        </div>
    </div>
</header>

<style>
    .navbar {
        backdrop-filter: blur(8px);
        background: var(--color-cream-90);
        height: var(--header-height);
    }

    .navbar__bar {
        align-items: center;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        height: 100%;
    }

    .navbar__brand {
        color: var(--color-charcoal);
        flex: none;
        gap: 12px;
        justify-self: start;
        position: relative;
        text-decoration: none;
        transition: color var(--duration-fast) ease;
    }

    .navbar__brand:active .navbar__logo,
    .navbar__brand:active .navbar__wordmark {
        transform: translateY(1px);
    }

    .navbar__brand:hover {
        color: var(--color-taupe);
    }

    .navbar__brand::after {
        content: '';
        inset: -16px -8px;
        position: absolute;
    }

    .navbar__controls {
        justify-self: end;
    }

    .navbar__link {
        color: var(--color-charcoal);
        display: block;
        font-family: var(--font-sans);
        font-size: 12px;
        letter-spacing: 0.16em;
        position: relative;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            border-color var(--duration-fast) ease,
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
    }

    .navbar__link:active {
        transform: translateY(1px);
    }

    .navbar__link:hover {
        color: var(--color-taupe);
    }

    .navbar__link::after {
        content: '';
        inset: -16px -8px;
        position: absolute;
    }

    .navbar__link--active {
        border-bottom: 1px solid var(--color-charcoal);
        padding-bottom: 2px;
    }

    .navbar__link--active:hover {
        border-color: var(--color-taupe);
    }

    .navbar__logo {
        background-color: currentColor;
        mask-image: url('../images/logos/figure_zero.webp');
        mask-position: center;
        mask-repeat: no-repeat;
        mask-size: contain;
        transition: transform var(--duration-fast) ease;
    }

    .navbar__theme {
        align-items: center;
        color: var(--color-charcoal);
        display: flex;
        height: 32px;
        justify-content: center;
        position: relative;
        transition:
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
        width: 32px;
    }

    .navbar__theme:active {
        transform: translateY(1px);
    }

    .navbar__theme:hover {
        color: var(--color-taupe);
    }

    .navbar__theme::after {
        content: '';
        inset: -8px;
        position: absolute;
    }

    .navbar__toggle {
        align-items: center;
        color: var(--color-charcoal);
        display: none;
        height: 32px;
        justify-content: center;
        position: relative;
        transition:
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
        width: 32px;
    }

    .navbar__toggle:active {
        transform: translateY(1px);
    }

    .navbar__toggle:hover {
        color: var(--color-taupe);
    }

    .navbar__toggle::after {
        content: '';
        inset: -8px;
        position: absolute;
    }

    .navbar__toggle[aria-expanded='true'] {
        --icon-menu-open: 1;
    }

    .navbar__wordmark {
        font-family: var(--font-display);
        font-size: clamp(14px, calc(13px + 0.3125vw), 17px);
        letter-spacing: 0.02em;
        transition: transform var(--duration-fast) ease;
    }

    @media (max-width: 768px) {
        .navbar:has(.navbar__menu--open) {
            backdrop-filter: none;
            background: var(--color-cream);
        }

        .navbar::after {
            background: var(--color-charcoal-35);
            content: '';
            inset: var(--header-height) 0 0;
            opacity: 0;
            position: fixed;
            transition:
                opacity var(--duration-fast) ease,
                visibility 0s ease var(--duration-fast);
            visibility: hidden;
            z-index: -1;
        }

        .navbar:has(.navbar__menu--open)::after {
            opacity: 1;
            transition: opacity var(--duration-fast) ease;
            visibility: visible;
        }

        .navbar__bar {
            display: flex;
            justify-content: space-between;
        }

        .navbar__brand::after {
            inset: -16px -6px;
        }

        .navbar__link {
            padding: 14px var(--shell-pad);
        }

        .navbar__link::after {
            content: none;
        }

        .navbar__link--active {
            border-bottom: none;
            text-decoration: underline;
            text-decoration-thickness: 1px;
            text-underline-offset: 5px;
        }

        .navbar__menu {
            align-items: stretch;
            background: var(--color-cream);
            border-bottom: 1px solid var(--color-linen);
            flex-direction: column;
            gap: 0;
            inset-inline: 0;
            opacity: 0;
            padding-block: 6px 10px;
            position: fixed;
            top: var(--header-height);
            transition:
                opacity var(--duration-fast) ease,
                visibility 0s ease var(--duration-fast);
            visibility: hidden;
        }

        .navbar__menu li {
            transition: none;
        }

        .navbar__menu--instant {
            transition: none;
        }

        .navbar__menu--open {
            opacity: 1;
            transition: opacity var(--duration-fast) ease;
            visibility: visible;
        }

        .navbar__toggle {
            display: flex;
        }
    }
</style>

<script define:vars={{ themeKey: THEME_KEY }}>
    let stored;

    try {
        const raw = localStorage.getItem(themeKey);

        stored = raw ? JSON.parse(raw).theme : null;
    } catch {
        stored = null;
    }

    if (stored === 'dark' || stored === 'light') document.documentElement.dataset.theme = stored;
</script>

<script>
    import { THEME_COLORS, THEME_KEY } from '@lib/constants';
    import { loadTheme, saveTheme } from '@lib/store';

    const DARK_QUERY = '(prefers-color-scheme: dark)';
    const FOCUSABLE_SELECTOR = 'a, button';
    const MOBILE_QUERY = '(max-width: 768px)';
    const REDUCED_QUERY = '(prefers-reduced-motion: reduce)';

    let controller: AbortController;
    let header: HTMLElement | null;
    let menu: HTMLElement | null;
    let themeChoice: Theme | null;
    let themeToggle: HTMLButtonElement | null;
    let toggle: HTMLButtonElement | null;

    function closeMenu(shouldRestoreFocus = false) {
        menu?.classList.remove('navbar__menu--open');
        toggle?.setAttribute('aria-expanded', 'false');

        if (shouldRestoreFocus) toggle?.focus();
    }

    function getChoice(): Theme | null {
        return themeChoice ?? loadTheme();
    }

    function getTheme(): Theme {
        return getChoice() ?? (window.matchMedia(DARK_QUERY).matches ? 'dark' : 'light');
    }

    function handleColorSchemeChange() {
        if (getChoice()) return;

        syncTheme();
    }

    function handleKeyDown(event: KeyboardEvent) {
        if (!menu?.classList.contains('navbar__menu--open')) return;

        if (event.key === 'Escape') {
            closeMenu(true);

            return;
        }

        if (event.key === 'Tab' && header) trapTabKey(event, header);
    }

    function handleMediaChange(event: MediaQueryListEvent) {
        if (!event.matches) {
            closeMenu();

            return;
        }

        menu?.classList.add('navbar__menu--instant');
        requestAnimationFrame(() => requestAnimationFrame(() => menu?.classList.remove('navbar__menu--instant')));
    }

    function handleMouseDown(event: MouseEvent) {
        if (!menu?.classList.contains('navbar__menu--open')) return;
        if (!(event.target instanceof Element)) return;

        if (!event.target.closest('.navbar') || event.clientY >= menu.getBoundingClientRect().bottom) closeMenu();
    }

    function handleNavToggle() {
        if (menu?.classList.contains('navbar__menu--open')) closeMenu(true);
        else openMenu();
    }

    function handleStorage(event: StorageEvent) {
        if (event.key !== THEME_KEY) return;

        syncTheme();
    }

    function handleThemeToggle() {
        const next: Theme = getTheme() === 'dark' ? 'light' : 'dark';

        themeChoice = next;
        saveTheme(next);

        if (!document.startViewTransition || window.matchMedia(REDUCED_QUERY).matches) {
            syncTheme();

            return;
        }

        document.startViewTransition(syncTheme);
    }

    function initNavbar() {
        if (controller) controller.abort();

        controller = new AbortController();

        const currentPath = normalizePath(window.location.pathname);

        header = document.querySelector<HTMLElement>('.navbar');
        menu = document.querySelector<HTMLElement>('[data-nav-menu]');
        themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
        toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

        syncTheme();

        document.querySelectorAll<HTMLAnchorElement>('.navbar__link').forEach((link) => {
            const linkPath = normalizePath(link.pathname);

            const isActive = linkPath === currentPath;

            link.classList.toggle('navbar__link--active', isActive);

            if (isActive) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');

            link.addEventListener('click', () => closeMenu(), { signal: controller.signal });
        });

        toggle?.addEventListener('click', handleNavToggle, { signal: controller.signal });

        themeToggle?.addEventListener('click', handleThemeToggle, { signal: controller.signal });

        document.addEventListener('keydown', handleKeyDown, { signal: controller.signal });
        document.addEventListener('mousedown', handleMouseDown, { signal: controller.signal });
        window.addEventListener('storage', handleStorage, { signal: controller.signal });
        window.matchMedia(DARK_QUERY).addEventListener('change', handleColorSchemeChange, { signal: controller.signal });
        window.matchMedia(MOBILE_QUERY).addEventListener('change', handleMediaChange, { signal: controller.signal });
    }

    function normalizePath(path: string) {
        return path.replace(/\/$/, '') || '/';
    }

    function openMenu() {
        menu?.classList.add('navbar__menu--open');
        toggle?.setAttribute('aria-expanded', 'true');
        menu?.querySelector<HTMLElement>('a')?.focus();
    }

    function syncTheme() {
        const choice = getChoice();
        const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
        const theme = getTheme();

        if (choice) document.documentElement.dataset.theme = choice;
        else delete document.documentElement.dataset.theme;

        themeToggle?.setAttribute('aria-pressed', String(theme === 'dark'));

        if (meta) meta.content = THEME_COLORS[theme];
    }

    function trapTabKey(event: KeyboardEvent, container: HTMLElement) {
        const targets = container.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR);

        const first = targets[0];
        const last = targets[targets.length - 1];

        if (event.shiftKey && (document.activeElement === first || !container.contains(document.activeElement))) {
            event.preventDefault();
            last?.focus();
        } else if (!event.shiftKey && (document.activeElement === last || !container.contains(document.activeElement))) {
            event.preventDefault();
            first?.focus();
        }
    }

    document.addEventListener('astro:page-load', initNavbar);
</script>

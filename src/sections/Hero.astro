---
import DoodleEllipse from '@components/DoodleEllipse.astro';

const FIGURE_LETTERS = [...'Figure'] as const;
const ZERO_LETTERS = [...'Zero'] as const;
---

<section
    class="flex flex-col isolate overflow-hidden relative py-[calc(var(--space-md)*1.5)]"
    aria-labelledby="hero-title"
>
    <div
        class="hero__doodle absolute right-[calc(var(--shell-margin)_-_var(--shell-pad)*0.5)] top-[34%] -z-1 aspect-7/4"
        aria-hidden="true"
        data-doodle
    >
        <DoodleEllipse />
    </div>
    <div class="shell">
        <h1
            id="hero-title"
            class="hero__title font-extrabold leading-[0.9] tracking-[-0.02em] uppercase"
            aria-label="Figure Zero"
            data-letters
        >
            <span
                class="block"
                aria-hidden="true"
            >
                {FIGURE_LETTERS.map(letter => (
                    <span
                        class="inline-block"
                        data-letter
                    >
                        {letter}
                    </span>
                ))}
            </span>
            <span
                class="hero__row flex items-end"
                aria-hidden="true"
            >
                <span class="font-semibold italic whitespace-nowrap">
                    {ZERO_LETTERS.map(letter => (
                        <span
                            class="inline-block"
                            data-letter
                        >
                            {letter}
                        </span>
                    ))}
                </span>
                <span class="hero__logo flex-none aspect-square bg-current mask-center mask-contain mask-no-repeat" data-pop />
            </span>
        </h1>
    </div>
</section>

<style>
    .hero__doodle {
        width: clamp(200px, calc(80px + 37.5vw), 560px);
    }

    .hero__logo {
        margin-bottom: clamp(4px, 1.25vw, 16px);
        mask-image: url('../images/logos/figure_zero.webp');
        width: clamp(48px, calc(10.6667px + 11.6667vw), 160px);
    }

    .hero__row {
        gap: clamp(12px, 3.75vw, 48px);
        padding-left: clamp(8px, calc(-42.6667px + 15.8333vw), 160px);
    }

    .hero__title {
        font-size: clamp(64px, calc(10.6667px + 16.6667vw), 224px);
    }
</style>

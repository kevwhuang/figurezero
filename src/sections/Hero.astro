---
import DoodleEllipse from '@components/DoodleEllipse.astro';
---

<section
    class="flex flex-col isolate overflow-hidden relative py-[calc(var(--section-pad)*2)]"
    aria-labelledby="hero-title"
>
    <div
        class="hero__doodle absolute right-[max(-4%,calc(50%_-_696px))] top-[34%] -z-1 max-md:top-[40%]"
        aria-hidden="true"
        data-doodle
    >
        <DoodleEllipse />
    </div>
    <div class="shell">
        <h1
            id="hero-title"
            class="hero__title font-extrabold leading-[0.9] tracking-[-0.02em] uppercase"
            aria-label="Figure Zero"
            data-letters
        >
            <span
                class="block"
                aria-hidden="true"
            >
                <span class="inline-block" data-letter>F</span><span class="inline-block" data-letter>i</span><span class="inline-block" data-letter>g</span><span class="inline-block" data-letter>u</span><span class="inline-block" data-letter>r</span><span class="inline-block" data-letter>e</span>
            </span>
            <span
                class="hero__row flex items-end"
                aria-hidden="true"
            >
                <span class="font-semibold italic"><span class="inline-block" data-letter>Z</span><span class="inline-block" data-letter>e</span><span class="inline-block" data-letter>r</span><span class="inline-block" data-letter>o</span></span>
                <span class="hero__logo flex-none aspect-square bg-current mask-center mask-contain mask-no-repeat" data-pop />
            </span>
        </h1>
    </div>
</section>

<style>
    .hero__doodle {
        height: clamp(116px, calc(44px + 22.5vw), 332px);
        opacity: 0.14;
        width: clamp(200px, calc(80px + 37.5vw), 560px);
    }

    .hero__logo {
        margin-bottom: clamp(2px, calc(-2.6667px + 1.4583vw), 16px);
        mask-image: url('../images/logos/figure_zero.webp');
        width: clamp(46px, calc(11.3333px + 10.8333vw), 150px);
    }

    .hero__row {
        gap: clamp(12px, calc(-1.33px + 4.17vw), 52px);
        padding-left: clamp(28px, calc(-18.6667px + 14.5833vw), 168px);
    }

    .hero__title {
        font-family: var(--font-poster);
        font-size: clamp(64px, calc(10.67px + 16.6667vw), 224px);
    }
</style>

---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import DoodleScribble from '@components/DoodleScribble.astro';
import { resolveImage } from '@lib/utils';

import type { CollectionEntry } from 'astro:content';

type GroupKey = CollectionEntry<'team'>['data']['group'];

const GROUPS: { key: GroupKey; label: string }[] = [
    { key: 'artists', label: 'Artists' },
    { key: 'investigators', label: 'Science investigators' },
    { key: 'interns', label: 'Summer interns' },
];

const members = (await getCollection('team')).sort((memberA, memberB) => memberA.data.name.localeCompare(memberB.data.name));

const memberGroups = GROUPS.map(group => ({
    label: group.label,
    members: members.filter(member => member.data.group === group.key),
}));

const presidents = members.filter(member => member.data.group === 'co-presidents');
---

<section
    id="team"
    class="section overflow-hidden relative isolate border-t border-charcoal"
    aria-labelledby="team-title"
>
    <h2
        id="team-title"
        class="shell team__title"
        data-scroll
    >
        Our <em>team</em>
    </h2>
    <div class="shell">
        <h3
            class="eyebrow mb-12"
            data-scroll
        >
            Co-presidents
        </h3>
        <ul>
            {presidents.map((president, index) => (
                <li>
                    <article class:list={['team__president', { 'team__president--flipped': index === 1 }]}>
                        <div
                            class="team__president-frame col-span-5 col-start-1 overflow-hidden"
                            data-scroll={index === 1 ? 'right' : 'left'}
                        >
                            <Image
                                class="team__president-image aspect-[4/5] object-cover w-full"
                                alt=""
                                sizes="(max-width: 1024px) calc(100vw - 2 * clamp(24px, 9.33px + 4.58vw, 68px)), 480px"
                                src={resolveImage(president.data.image)}
                                width={600}
                                widths={[420, 600, 1200]}
                            />
                        </div>
                        <div
                            class="team__president-text col-span-6 col-start-7 pt-12"
                            data-scroll={index === 1 ? 'left' : 'right'}
                        >
                            <h4 class="team__president-name">{president.data.name}</h4>
                            <p class="eyebrow team__president-program">{president.data.program}</p>
                            <p class="team__president-bio">{president.data.bio}</p>
                        </div>
                    </article>
                </li>
            ))}
        </ul>
    </div>
    {memberGroups.map((group, index) => (
        <div class:list={['shell team__group', { 'team__group--first': index === 0 }]}>
            {index === 1 && (
                <div
                    class="team__doodle absolute -z-1 max-md:hidden"
                    aria-hidden="true"
                >
                    <DoodleScribble />
                </div>
            )}
            <h3
                class="eyebrow mb-12"
                data-scroll
            >
                {group.label}
            </h3>
            <ul
                class="team__grid flex flex-wrap justify-center gap-x-6 gap-y-[clamp(32px,calc(24px+2.5vw),56px)]"
                data-scroll="zoom"
                data-scroll-stagger="0.08"
            >
                {group.members.map(member => (
                    <li>
                        <figure class="team__member grid gap-3">
                            <div class="overflow-hidden">
                                <Image
                                    class="team__member-photo aspect-[4/5] object-cover w-full"
                                    alt=""
                                    sizes="(max-width: 768px) 43vw, (max-width: 1280px) 29vw, 368px"
                                    src={resolveImage(member.data.image)}
                                    width={400}
                                    widths={[220, 400, 440, 800]}
                                />
                            </div>
                            <figcaption class="grid gap-1">
                                <p class="team__member-name">{member.data.name}</p>
                                {member.data.program && <p class="team__member-program">{member.data.program}</p>}
                            </figcaption>
                        </figure>
                    </li>
                ))}
            </ul>
        </div>
    ))}
</section>

<style>
    .team__doodle {
        height: clamp(120px, calc(100px + 6.25vw), 180px);
        opacity: 0.07;
        right: 0;
        top: calc(-1 * var(--gap-block));
        width: clamp(200px, calc(153.33px + 14.58vw), 340px);
    }

    .team__grid li {
        flex: 0 0 calc((100% - 48px) / 3);
        min-width: 0;
    }

    .team__group {
        margin-bottom: var(--gap-block);
        position: relative;
    }

    .team__group:last-child {
        margin-bottom: 0;
    }

    .team__group--first {
        border-top: 1px solid var(--color-linen);
        padding-top: var(--pad-block);
    }

    .team__member:hover .team__member-photo {
        transform: scale(1.04);
    }

    .team__member-name {
        font-family: var(--font-display);
        font-size: 17px;
        overflow-wrap: anywhere;
    }

    .team__member-photo {
        transition: transform var(--duration-slow) var(--ease-soft);
    }

    .team__member-program {
        color: var(--color-taupe);
        font-size: 13px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .team__president {
        align-items: start;
        display: grid;
        gap: 28px;
        grid-template-columns: repeat(12, 1fr);
        margin-bottom: var(--gap-block);
    }

    .team__president--flipped .team__president-frame {
        grid-column: 8 / span 5;
        grid-row: 1;
    }

    .team__president--flipped .team__president-text {
        grid-column: 1 / span 6;
        grid-row: 1;
    }

    .team__president-bio {
        color: var(--color-umber);
        font-size: 17px;
        line-height: 1.7;
        max-width: var(--measure-prose);
        overflow-wrap: anywhere;
        text-wrap: pretty;
    }

    .team__president-frame:hover .team__president-image {
        transform: scale(1.04);
    }

    .team__president-image {
        transition: transform var(--duration-slow) var(--ease-soft);
    }

    .team__president-name {
        font-family: var(--font-display);
        font-size: clamp(30px, calc(24px + 1.875vw), 48px);
        font-weight: 460;
        line-height: 1.02;
        margin-bottom: 16px;
        overflow-wrap: anywhere;
    }

    .team__president-program {
        letter-spacing: 0.16em;
        margin-bottom: 40px;
    }

    .team__title {
        font-family: var(--font-poster);
        font-size: clamp(52px, calc(22.67px + 9.17vw), 140px);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 0.95;
        margin-bottom: var(--gap-block);
    }

    .team__title em {
        font-weight: 600;
    }

    @media (max-width: 1024px) {
        .team__president {
            display: block;
        }

        .team__president-frame {
            margin-bottom: 40px;
        }

        .team__president-text {
            padding-top: 0;
        }
    }

    @media (max-width: 768px) {
        .team__grid li {
            flex-basis: calc((100% - 24px) / 2);
        }
    }
</style>

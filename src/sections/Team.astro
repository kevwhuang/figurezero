---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import { resolveImage } from '@lib/utils';

import type { CollectionEntry } from 'astro:content';

type GroupKey = CollectionEntry<'team'>['data']['group'];

const GROUPS = [
    { key: 'artists', label: 'Artists' },
    { key: 'investigators', label: 'Science investigators' },
    { key: 'interns', label: 'Summer interns' },
] as const satisfies readonly { key: GroupKey; label: string }[];

const PRESIDENT_LAYOUTS = [
    { frame: 'col-span-5 col-start-1 overflow-hidden', frameScroll: 'left', text: 'col-span-6 col-start-7', textScroll: 'right' },
    { frame: 'col-span-5 col-start-8 overflow-hidden row-start-1', frameScroll: 'right', text: 'col-span-6 col-start-1 row-start-1', textScroll: 'left' },
] as const;

const members = (await getCollection('team')).sort((memberA, memberB) => memberA.data.name.localeCompare(memberB.data.name));

const membersByGroup = Object.groupBy(members, member => member.data.group);

const coPresidents = membersByGroup['co-presidents'] ?? [];

const memberGroups = GROUPS.map(group => ({
    label: group.label,
    members: membersByGroup[group.key] ?? [],
}));

const presidents = coPresidents.map((coPresident, index) => ({
    data: coPresident.data,
    ...(PRESIDENT_LAYOUTS[index] ?? PRESIDENT_LAYOUTS[0]),
}));
---

<section
    class="section team isolate overflow-hidden relative"
    aria-labelledby="team-title"
>
    <div class="shell">
        <div class="pb-(--pad-block)">
            <p
                class="eyebrow eyebrow--kicker"
                data-rise
            >
                The people behind the project
            </p>
            <h1
                id="team-title"
                class="team__title font-[800] leading-[0.9] text-title tracking-[-0.02em]"
                data-rise
            >
                Our <em class="font-semibold">team</em>
            </h1>
        </div>
        <h2
            class="eyebrow mb-12"
            data-scroll
        >
            Co-presidents
        </h2>
        <ul>
            {presidents.map(president => (
                <li>
                    <article class="grid grid-cols-12 items-start gap-7 mb-(--gap-block) max-lg:block">
                        <div
                            class={`group ${president.frame} max-lg:mb-10`}
                            data-scroll={president.frameScroll}
                        >
                            <Image
                                class="group-hover:scale-(--photo-zoom) aspect-square object-cover w-full duration-(--duration-slow) ease-soft transition-[scale]"
                                alt=""
                                sizes="(max-width: 1024px) calc(100vw - 2 * clamp(24px, 9.33px + 4.58vw, 68px)), 460px"
                                src={resolveImage(president.data.image)}
                                width={600}
                                widths={[420, 600, 1200]}
                            />
                        </div>
                        <div
                            class={`${president.text} pt-12 max-lg:pt-0`}
                            data-scroll={president.textScroll}
                        >
                            <h3 class="team__president-name mb-4 font-[460] leading-[1.02] wrap-anywhere">{president.data.name}</h3>
                            <p class="eyebrow team__president-program mb-10 wrap-anywhere">{president.data.program}</p>
                            <p class="max-w-(--measure-prose) leading-[1.7] text-[18px] text-pretty wrap-anywhere text-umber max-lg:max-w-none">{president.data.bio}</p>
                        </div>
                    </article>
                </li>
            ))}
        </ul>
    </div>
    {memberGroups.map((group, index) => (
        <section
            class:list={['shell last:mb-0 relative mb-(--gap-block)', { 'pt-(--pad-block) border-t border-linen': index === 0 }]}
            aria-label={group.label}
        >
            <h2
                class="eyebrow mb-12"
                data-scroll
            >
                {group.label}
            </h2>
            <ul
                class="flex flex-wrap justify-center gap-x-(--gap-grid) gap-y-(--pad-block)"
                data-scroll="zoom"
                data-scroll-stagger="0.08"
            >
                {group.members.map(member => (
                    <li class="basis-[calc((100%_-_2_*_var(--gap-grid))_/_3)] grow-0 shrink-0 min-w-0 max-md:basis-[calc((100%_-_var(--gap-grid))_/_2)]">
                        <figure class="group grid gap-3">
                            <div class="overflow-hidden">
                                <Image
                                    class="group-hover:scale-(--photo-zoom) aspect-square object-cover w-full duration-(--duration-slow) ease-soft transition-[scale]"
                                    alt=""
                                    sizes="(max-width: 768px) 43vw, min(29vw, 368px)"
                                    src={resolveImage(member.data.image)}
                                    width={400}
                                    widths={[220, 400, 440, 800]}
                                />
                            </div>
                            <figcaption class="grid gap-1">
                                <p class="font-display text-[18px] wrap-anywhere">{member.data.name}</p>
                                {member.data.program && <p class="leading-[1.5] text-[14px] wrap-anywhere text-taupe">{member.data.program}</p>}
                            </figcaption>
                        </figure>
                    </li>
                ))}
            </ul>
        </section>
    ))}
</section>

<style>
    .team {
        --photo-zoom: 1.04;
    }

    .team__president-name {
        font-size: clamp(28px, calc(21.33px + 2.0833vw), 48px);
    }

    .team__president-program {
        letter-spacing: 0.16em;
    }

    .team__title {
        font-family: var(--font-poster);
    }
</style>

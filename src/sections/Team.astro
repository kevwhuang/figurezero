---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import { SHELL_PAD } from '@lib/constants';
import { resolveImage } from '@lib/utils';

const GROUPS = [
    { key: 'artists', label: 'Artists' },
    { key: 'investigators', label: 'Science investigators' },
    { key: 'interns', label: 'Summer interns' },
] as const;

const PRESIDENT_FRAMES = [
    'col-span-6 col-start-1 overflow-hidden',
    'col-span-6 col-start-7 overflow-hidden row-start-1',
] as const;

const PRESIDENT_TEXTS = [
    'col-span-5 col-start-8',
    'col-span-5 col-start-1 row-start-1',
] as const;

const members = (await getCollection('team')).sort((memberA, memberB) => memberA.data.name.localeCompare(memberB.data.name));

const membersByGroup = Object.groupBy(members, member => member.data.group);

const presidents = membersByGroup['co-presidents'] ?? [];
---

<section
    class="section overflow-hidden"
    aria-labelledby="team-title"
>
    <div class="shell pb-(--space-md)">
        <p
            class="eyebrow eyebrow--kicker mb-(--space-sm) pt-3 border-t border-charcoal"
            data-rise
        >
            The people behind the project
        </p>
        <h1
            id="team-title"
            class="font-extrabold leading-[0.9] text-title tracking-[-0.02em]"
            data-rise
        >
            Our <em class="font-semibold">team</em>
        </h1>
    </div>
    <section
        class="shell mb-(--space-md) pb-(--space-md) border-b border-linen"
        aria-label="Co-presidents"
    >
        <h2
            class="eyebrow mb-12 pt-(--space-md) border-t border-charcoal"
            data-scroll
        >
            Co-presidents
        </h2>
        <ul class="grid gap-(--space-md)">
            {presidents.map((president, index) => (
                <li>
                    <article class="grid grid-cols-12 items-center gap-6 max-lg:block">
                        <div
                            class={`group ${PRESIDENT_FRAMES[index % PRESIDENT_FRAMES.length]} max-lg:mb-12`}
                            data-scroll={index % 2 === 0 ? 'left' : 'right'}
                        >
                            <Image
                                class="group-hover:scale-105 aspect-square object-cover w-full duration-(--duration-slow) ease-[ease] transition-[scale]"
                                alt=""
                                sizes={`(max-width: 1024px) calc(100vw - 2 * ${SHELL_PAD}), 560px`}
                                src={resolveImage(president.data.image)}
                                width={600}
                                widths={[420, 600, 1_200]}
                            />
                        </div>
                        <div
                            class={PRESIDENT_TEXTS[index % PRESIDENT_TEXTS.length]}
                            data-scroll={index % 2 === 0 ? 'right' : 'left'}
                        >
                            <h3 class="team__president-name mb-4 font-medium leading-[1] text-balance wrap-anywhere">{president.data.name}</h3>
                            <p class="eyebrow mb-8 text-balance wrap-anywhere">{president.data.program}</p>
                            <p class="leading-[1.7] text-body text-pretty wrap-anywhere text-umber">{president.data.bio}</p>
                        </div>
                    </article>
                </li>
            ))}
        </ul>
    </section>
    {GROUPS.map(group => (
        <section
            class="shell last:mb-0 mb-(--space-md)"
            aria-label={group.label}
        >
            <h2
                class="eyebrow mb-12"
                data-scroll
            >
                {group.label}
            </h2>
            <ul
                class="flex flex-wrap justify-center gap-x-(--space-xs) gap-y-(--space-sm)"
                data-scroll="zoom"
                data-scroll-stagger="0.1"
            >
                {(membersByGroup[group.key] ?? []).map(member => (
                    <li class="basis-[calc((100%_-_2_*_var(--space-xs))_/_3)] grow-0 min-w-0 shrink-0 max-md:basis-full">
                        <figure class="group grid gap-3">
                            <div class="overflow-hidden">
                                <Image
                                    class="group-hover:scale-105 aspect-square object-cover w-full duration-(--duration-slow) ease-[ease] transition-[scale]"
                                    alt=""
                                    sizes={`(max-width: 768px) calc(100vw - 2 * ${SHELL_PAD}), min(30vw, 360px)`}
                                    src={resolveImage(member.data.image)}
                                    width={400}
                                    widths={[220, 400, 440, 800]}
                                />
                            </div>
                            <figcaption class="grid gap-1">
                                <p class="font-display text-body wrap-anywhere">{member.data.name}</p>
                                {member.data.program && <p class="leading-[1.5] text-balance text-meta wrap-anywhere text-taupe">{member.data.program}</p>}
                            </figcaption>
                        </figure>
                    </li>
                ))}
            </ul>
        </section>
    ))}
</section>

<style>
    .team__president-name {
        font-size: clamp(28px, calc(21.3333px + 2.0833vw), 48px);
    }
</style>

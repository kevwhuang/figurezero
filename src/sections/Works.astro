---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import DoodleEllipse from '@components/DoodleEllipse.astro';
import { resolveImage } from '@lib/utils';

const coverWidths = [558, 656, 460, 558];

const works = (await getCollection('portfolio')).sort((workA, workB) => workA.data.title.localeCompare(workB.data.title));
---

<section
    class="overflow-hidden relative isolate"
    aria-labelledby="works-title"
>
    <div class="shell">
        <div class="works__hero">
            <p
                class="eyebrow eyebrow--kicker"
                data-rise
            >
                Images of our past work
            </p>
            <h1
                id="works-title"
                class="works__title"
                data-rise
            >
                Port<span class="inline-block relative whitespace-nowrap"><em>folio</em><DoodleEllipse /></span>
            </h1>
        </div>
        <ol class="works__list border-t border-charcoal">
            {works.map((work, index) => (
                <li>
                    <article class="works__item">
                        <figure
                            class="works__figure col-span-6 col-start-1"
                            data-scroll={index % 2 === 0 ? 'left' : 'right'}
                        >
                            <Image
                                class="works__cover hover:shadow-cover-hover h-auto w-full shadow-cover"
                                alt={`${work.data.title} cover illustration`}
                                sizes={`(max-width: 1024px) calc(100vw - 2 * clamp(24px, 9.33px + 4.58vw, 68px)), ${coverWidths[index] ?? coverWidths[0]}px`}
                                src={resolveImage(work.data.image)}
                                width={700}
                                widths={[420, 700, 940, 1200]}
                            />
                        </figure>
                        <div
                            class="works__body col-span-5 col-start-8 relative"
                            data-scroll={index % 2 === 0 ? 'right' : 'left'}
                        >
                            {index === 0 && (
                                <div
                                    class="works__doodle absolute -z-1"
                                    aria-hidden="true"
                                >
                                    <DoodleEllipse />
                                </div>
                            )}
                            <p
                                class="works__index"
                                aria-hidden="true"
                            >
                                {String(index + 1).padStart(2, '0')}
                            </p>
                            <h2 class="works__name text-pretty">{work.data.title}</h2>
                            <p class="eyebrow works__credit">{work.data.artist}<br />{work.data.school}</p>
                        </div>
                    </article>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .works__cover {
        transition: box-shadow var(--duration-slow) var(--ease-soft);
    }

    .works__credit {
        letter-spacing: 0.16em;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    .works__doodle {
        height: clamp(64px, calc(47.33px + 5.21vw), 114px);
        left: -28px;
        opacity: 0.06;
        top: -14px;
        width: clamp(120px, calc(90px + 9.375vw), 210px);
    }

    .works__hero {
        padding-bottom: var(--pad-block);
        padding-top: var(--section-pad);
    }

    .works__index {
        -webkit-text-stroke: 1.2px var(--color-charcoal);
        color: transparent;
        font-family: var(--font-display);
        font-size: clamp(56px, calc(40px + 5vw), 104px);
        font-weight: 400;
        line-height: 0.8;
        margin-bottom: 32px;
    }

    .works__item {
        align-items: end;
        border-bottom: 1px solid var(--color-linen);
        display: grid;
        gap: 28px;
        grid-template-columns: repeat(12, 1fr);
        padding-block: var(--pad-block);
    }

    .works__list li:nth-child(2) .works__body,
    .works__list li:nth-child(4) .works__body {
        grid-column: 1 / span 5;
        grid-row: 1;
    }

    .works__list li:nth-child(2) .works__figure {
        grid-column: 6 / span 7;
        grid-row: 1;
    }

    .works__list li:nth-child(3) .works__figure {
        grid-column: 2 / span 5;
    }

    .works__list li:nth-child(4) .works__figure {
        grid-column: 7 / span 6;
        grid-row: 1;
    }

    .works__name {
        font-size: clamp(26px, calc(21.33px + 1.46vw), 40px);
        font-weight: 450;
        letter-spacing: -0.01em;
        line-height: 1.08;
        margin-bottom: 16px;
        overflow-wrap: anywhere;
    }

    .works__title {
        font-family: var(--font-poster);
        font-size: clamp(58px, calc(17.33px + 12.71vw), 180px);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 0.9;
    }

    .works__title em {
        font-weight: 600;
    }

    @media (max-width: 1024px) {
        .works__figure {
            margin-bottom: 40px;
        }

        .works__item {
            display: block;
        }
    }

    @media (max-width: 768px) {
        .works__doodle {
            left: -8px;
        }
    }
</style>

---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import DoodleEllipse from '@components/DoodleEllipse.astro';
import { SHELL_PAD } from '@lib/constants';
import { resolveImage } from '@lib/utils';

const COVER_WIDTH = 560;

const WORK_BODIES = [
    'col-span-5 col-start-8 relative',
    'col-span-5 col-start-1 relative row-start-1 text-right',
] as const;

const WORK_FIGURES = [
    'col-span-6 col-start-1',
    'col-span-6 col-start-7 row-start-1',
] as const;

const works = (await getCollection('portfolio')).sort((workA, workB) => workA.data.title.localeCompare(workB.data.title));
---

<section
    class="isolate overflow-hidden relative"
    aria-labelledby="works-title"
>
    <div class="shell">
        <div class="py-(--space-md)">
            <p
                class="eyebrow eyebrow--kicker mb-(--space-sm) pt-3 border-t border-charcoal"
                data-rise
            >
                Images of our past work
            </p>
            <h1
                id="works-title"
                class="font-extrabold leading-[0.9] text-title tracking-[-0.02em]"
                aria-label="The Portfolio"
                data-rise
            >
                The <span class="inline-block whitespace-nowrap">Port<span class="inline-block relative whitespace-nowrap"><span class="font-semibold italic">folio</span><DoodleEllipse /></span></span>
            </h1>
        </div>
        <ol class="border-t border-charcoal">
            {works.map((work, index) => (
                <li>
                    <article class="grid grid-cols-12 items-end gap-6 py-(--space-md) border-b border-linen max-lg:block">
                        <figure
                            class={`${WORK_FIGURES[index % WORK_FIGURES.length]} max-lg:mb-12`}
                            data-scroll={index % 2 === 0 ? 'left' : 'right'}
                        >
                            <Image
                                class="h-auto w-full"
                                alt={`${work.data.title} cover illustration`}
                                fetchpriority={index === 0 ? 'high' : undefined}
                                loading={index === 0 ? 'eager' : 'lazy'}
                                sizes={`(width < 1024px) calc(100vw - 2 * ${SHELL_PAD}), ${COVER_WIDTH}px`}
                                src={resolveImage(work.data.image)}
                                width={700}
                                widths={[420, 700, 940, 1_200]}
                            />
                        </figure>
                        <div
                            class={WORK_BODIES[index % WORK_BODIES.length]}
                            data-scroll={index % 2 === 0 ? 'right' : 'left'}
                        >
                            {index === 0 && (
                                <div
                                    class="works__doodle -left-6 -top-4 absolute -z-1 opacity-(--opacity-doodle)"
                                    aria-hidden="true"
                                >
                                    <DoodleEllipse />
                                </div>
                            )}
                            <p
                                class="works__index mb-8 font-display font-normal leading-[0.8] text-ornament text-transparent select-none"
                                aria-hidden="true"
                            >
                                {String(index + 1).padStart(2, '0')}
                            </p>
                            <h2 class="works__name mb-4 font-medium leading-[1.1] text-balance tracking-[-0.01em] wrap-anywhere">{work.data.title}</h2>
                            <p class="eyebrow leading-[1.7] wrap-anywhere">{work.data.artist}<br />{work.data.school}</p>
                        </div>
                    </article>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .works__doodle {
        height: clamp(64px, calc(48px + 5vw), 112px);
        width: clamp(120px, calc(93.3333px + 8.3333vw), 200px);
    }

    .works__index {
        -webkit-text-stroke: 1.5px var(--color-charcoal);
    }

    .works__name {
        font-size: clamp(28px, calc(24px + 1.25vw), 40px);
    }
</style>

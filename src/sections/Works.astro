---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import DoodleEllipse from '@components/DoodleEllipse.astro';
import { resolveImage } from '@lib/utils';

const COVER_WIDTHS = [558, 656, 460, 558] as const;

const works = (await getCollection('portfolio')).sort((workA, workB) => workA.data.title.localeCompare(workB.data.title));
---

<section
    class="overflow-hidden relative isolate"
    aria-labelledby="works-title"
>
    <div class="shell">
        <div class="pb-(--pad-block) pt-(--section-pad)">
            <p
                class="eyebrow eyebrow--kicker"
                data-rise
            >
                Images of our past work
            </p>
            <h1
                id="works-title"
                class="works__title font-extrabold leading-[0.9] tracking-[-0.02em]"
                aria-label="Portfolio"
                data-rise
            >
                The Port<span class="inline-block relative whitespace-nowrap"><em>folio</em><DoodleEllipse /></span>
            </h1>
        </div>
        <ol class="works__list border-t border-charcoal">
            {works.map((work, index) => (
                <li>
                    <article class="works__item grid grid-cols-12 items-end gap-7 py-(--pad-block) border-b border-linen">
                        <figure
                            class="works__figure col-span-6 col-start-1"
                            data-scroll={index % 2 === 0 ? 'left' : 'right'}
                        >
                            <Image
                                class="works__cover hover:shadow-cover-hover h-auto w-full shadow-cover duration-(--duration-slow) ease-soft transition-shadow"
                                alt={`${work.data.title} cover illustration`}
                                fetchpriority={index === 0 ? 'high' : undefined}
                                loading={index === 0 ? 'eager' : 'lazy'}
                                sizes={`(max-width: 1024px) calc(100vw - 2 * clamp(24px, 9.33px + 4.58vw, 68px)), ${COVER_WIDTHS[index] ?? COVER_WIDTHS[0]}px`}
                                src={resolveImage(work.data.image)}
                                width={700}
                                widths={[420, 700, 940, 1200]}
                            />
                        </figure>
                        <div
                            class="works__body col-span-5 col-start-8 relative"
                            data-scroll={index % 2 === 0 ? 'right' : 'left'}
                        >
                            {index === 0 && (
                                <div
                                    class="works__doodle -left-7 -top-3.5 absolute -z-1 opacity-[0.14]"
                                    aria-hidden="true"
                                >
                                    <DoodleEllipse />
                                </div>
                            )}
                            <p
                                class="works__index mb-8 font-display font-normal leading-[0.8] text-transparent select-none"
                                aria-hidden="true"
                            >
                                {String(index + 1).padStart(2, '0')}
                            </p>
                            <h2 class="works__name mb-4 font-[450] leading-[1.08] text-pretty tracking-[-0.01em] wrap-anywhere">{work.data.title}</h2>
                            <p class="eyebrow works__credit leading-[1.8] wrap-anywhere">{work.data.artist}<br />{work.data.school}</p>
                        </div>
                    </article>
                </li>
            ))}
        </ol>
    </div>
</section>

<style>
    .works__credit {
        letter-spacing: 0.16em;
    }

    .works__doodle {
        height: clamp(64px, calc(47.33px + 5.21vw), 114px);
        width: clamp(120px, calc(90px + 9.375vw), 210px);
    }

    .works__index {
        -webkit-text-stroke: 1.2px var(--color-charcoal);
        font-size: clamp(56px, calc(40px + 5vw), 104px);
    }

    .works__list li:nth-child(2) .works__body,
    .works__list li:nth-child(4) .works__body {
        grid-column: 1 / span 5;
        grid-row: 1;
    }

    .works__list li:nth-child(2) .works__figure {
        grid-column: 6 / span 7;
        grid-row: 1;
    }

    .works__list li:nth-child(3) .works__figure {
        grid-column: 2 / span 5;
    }

    .works__list li:nth-child(4) .works__figure {
        grid-column: 7 / span 6;
        grid-row: 1;
    }

    .works__name {
        font-size: clamp(28px, calc(24px + 1.25vw), 40px);
    }

    .works__title {
        font-family: var(--font-poster);
        font-size: clamp(58px, calc(17.33px + 12.71vw), 180px);
    }

    .works__title em {
        font-weight: 600;
    }

    @media (max-width: 1024px) {
        .works__figure {
            margin-bottom: 40px;
        }

        .works__item {
            display: block;
        }
    }

    @media (max-width: 768px) {
        .works__doodle {
            left: -8px;
        }
    }
</style>

---
import { CLASS_ERROR_LINK } from '@lib/constants';
---

<section
    class="section grid place-items-center min-h-[60svh]"
    aria-labelledby="error-not-found-title"
>
    <div
        class="shell text-center"
        data-scroll
    >
        <h1
            id="error-not-found-title"
            class="error__title mb-(--space-sm) font-medium leading-[0.9]"
        >
            404
        </h1>
        <p class="mb-(--space-xs) text-body text-umber">This page does not exist.</p>
        <a
            class={CLASS_ERROR_LINK}
            href="/"
        >
            Back to home
        </a>
    </div>
</section>

---
import DoodleArrow from '@components/DoodleArrow.astro';
import DoodleUnderline from '@components/DoodleUnderline.astro';
import DoodleWave from '@components/DoodleWave.astro';
---

<section
    class="section isolate overflow-hidden relative border-t border-charcoal"
    aria-label="What is the Figure Zero Project?"
>
    <div
        class="about__doodle-arrow absolute left-[calc(var(--shell-margin)_+_var(--shell-pad))] top-[28%] -z-1 opacity-(--opacity-doodle) max-lg:hidden"
        aria-hidden="true"
    >
        <DoodleArrow />
    </div>
    <div class="shell">
        <div class="grid grid-cols-12 gap-6 max-lg:block">
            <h2
                class="eyebrow col-span-3 col-start-1 max-lg:mb-12"
                data-scroll
            >
                What is the<br />Figure Zero Project?
            </h2>
            <div class="col-span-8 col-start-5">
                <p
                    class="about__statement mb-(--space-sm) font-display font-normal leading-[1.1] text-pretty tracking-[-0.01em]"
                    data-scroll
                >
                    We are a student-run organization committed to making science more <span class="inline-block relative whitespace-nowrap"><em>engaging</em><DoodleWave /></span> and <span class="inline-block relative whitespace-nowrap">accessible<DoodleUnderline /></span> to the public.
                </p>
                <div
                    class="grid grid-cols-2 gap-6 max-lg:grid-cols-1"
                    data-scroll="left"
                    data-scroll-stagger="0.2"
                >
                    <p class="leading-[1.7] text-body text-pretty text-umber">Many journals do not have graphic designers for their covers and illustrations, yet visuals are what aid understanding and grab people's attention. We achieve our goal of elevating science by recruiting passionate artists and writers who value self-expression from human creativity in the rising age of AI.</p>
                    <p class="leading-[1.7] text-body text-pretty text-umber">While students benefit by building robust and meaningful portfolios, journals and researchers gain original artwork and writing that highlight their research. Together, we build a diverse community connected by scientific journals' cover page&mdash;Figure Zero.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .about__doodle-arrow {
        height: clamp(90px, calc(70px + 6.25vw), 150px);
        width: clamp(200px, calc(153.3333px + 14.5833vw), 340px);
    }

    .about__statement {
        font-size: clamp(28px, calc(20px + 2.5vw), 52px);
    }
</style>

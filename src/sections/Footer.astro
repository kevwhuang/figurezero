---
import { Image } from 'astro:assets';

import logo from '@images/logos/figure_zero.webp';
import { ROUTES } from '@lib/constants';

const EMAIL = 'figure.zero.project@gmail.com';
const INSTAGRAM = 'figure.zero.project';
---

<footer class="pb-8 pt-(--pad-block) border-t border-charcoal">
    <div class="shell">
        <div class="footer__grid grid grid-cols-12 items-start gap-7 mb-(--gap-block)">
            <div class="col-span-3 col-start-1">
                <Image class="block h-auto w-28 mix-blend-multiply" alt="Figure Zero Project logo" densities={[1, 2]} src={logo} width={112} />
            </div>
            <div class="col-span-4 col-start-5 max-lg:col-start-4">
                <p
                    id="footer-navigation-title"
                    class="eyebrow mb-5"
                >
                    Navigation
                </p>
                <nav aria-labelledby="footer-navigation-title">
                    <ul class="grid gap-2.5">
                        {ROUTES.filter(route => route.isFooter).map(route => (
                            <li>
                                <a
                                    class="footer__link"
                                    href={route.href}
                                >
                                    {route.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </div>
            <div class="col-span-4 col-start-9 max-lg:col-span-5 max-lg:col-start-8">
                <p
                    id="footer-contact-title"
                    class="eyebrow mb-5"
                >
                    Contact
                </p>
                <address
                    class="not-italic"
                    aria-labelledby="footer-contact-title"
                >
                    <ul class="grid gap-2.5">
                        <li>
                            <a
                                class="footer__link"
                                href={`mailto:${EMAIL}`}
                            >
                                {EMAIL}
                            </a>
                        </li>
                        <li>
                            <a
                                class="footer__link"
                                href={`https://instagram.com/${INSTAGRAM}`}
                                rel="noopener"
                                target="_blank"
                            >
                                @{INSTAGRAM}
                            </a>
                        </li>
                    </ul>
                </address>
            </div>
        </div>
        <div class="pt-6 border-t border-linen">
            <p class="eyebrow footer__copyright">&copy; 2026 Figure Zero Project. All rights reserved.</p>
        </div>
    </div>
</footer>

<style>
    .footer__copyright {
        letter-spacing: 0.16em;
    }

    .footer__link {
        color: var(--color-charcoal);
        display: inline-block;
        font-size: 15px;
        overflow-wrap: anywhere;
        position: relative;
        text-decoration: none;
        transition:
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
    }

    .footer__link:active {
        transform: translateY(1px);
    }

    .footer__link:hover {
        color: var(--color-taupe);
    }

    .footer__link::after {
        content: '';
        inset: -5px 0;
        position: absolute;
    }

    @media (max-width: 768px) {
        .footer__grid {
            display: block;
        }

        .footer__grid > * {
            margin-bottom: 40px;
        }

        .footer__grid > :last-child {
            margin-bottom: 0;
        }
    }
</style>

---
import { Image } from 'astro:assets';

import logo from '@images/logos/figure_zero.webp';
import { ROUTES } from '@lib/constants';

const EMAIL = 'figure.zero.project@gmail.com';
const INSTAGRAM = 'figure.zero.project';
---

<footer class="pb-8 pt-18 border-t border-charcoal">
    <div class="shell">
        <div class="footer__grid">
            <div class="col-span-3 col-start-1">
                <Image class="footer__logo" alt="Figure Zero Project logo" densities={[1, 2]} quality="max" src={logo} width={112} />
            </div>
            <div class="col-span-4 col-start-5">
                <p
                    id="footer-navigation-title"
                    class="eyebrow mb-5"
                >
                    Navigation
                </p>
                <nav aria-labelledby="footer-navigation-title">
                    <ul class="grid gap-2.5">
                        {ROUTES.filter(route => route.isFooter).map(route => (
                            <li>
                                <a
                                    class="footer__link"
                                    href={route.href}
                                >
                                    {route.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </div>
            <div class="col-span-4 col-start-9">
                <p
                    id="footer-contact-title"
                    class="eyebrow mb-5"
                >
                    Contact
                </p>
                <address
                    class="not-italic"
                    aria-labelledby="footer-contact-title"
                >
                    <ul class="grid gap-2.5">
                        <li>
                            <a
                                class="footer__link"
                                href={`mailto:${EMAIL}`}
                            >
                                {EMAIL}
                            </a>
                        </li>
                        <li>
                            <a
                                class="footer__link"
                                href={`https://instagram.com/${INSTAGRAM}`}
                                rel="noopener"
                                target="_blank"
                            >
                                @{INSTAGRAM}
                            </a>
                        </li>
                    </ul>
                </address>
            </div>
        </div>
        <div class="footer__bottom">
            <p class="footer__copyright">&copy; 2026 Figure Zero Project. All rights reserved.</p>
        </div>
    </div>
</footer>

<style>
    .footer__bottom {
        border-top: 1px solid var(--color-linen);
        padding-top: 24px;
    }

    .footer__copyright {
        color: var(--color-taupe);
        font-family: var(--font-sans);
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .footer__grid {
        align-items: start;
        display: grid;
        gap: 28px;
        grid-template-columns: repeat(12, 1fr);
        margin-bottom: 56px;
    }

    .footer__link {
        color: var(--color-charcoal);
        font-size: 15px;
        overflow-wrap: anywhere;
        position: relative;
        text-decoration: none;
        transition:
            color var(--duration-fast) ease,
            transform var(--duration-fast) ease;
    }

    .footer__link:active {
        transform: translateY(1px);
    }

    .footer__link:hover {
        color: var(--color-taupe);
    }

    .footer__link::after {
        content: '';
        inset: -5px 0;
        position: absolute;
    }

    .footer__logo {
        display: block;
        height: auto;
        mix-blend-mode: multiply;
        width: 112px;
    }

    @media (max-width: 768px) {
        .footer__grid {
            display: block;
        }

        .footer__grid > * {
            margin-bottom: 40px;
        }

        .footer__grid > :last-child {
            margin-bottom: 0;
        }
    }
</style>

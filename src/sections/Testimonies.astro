---
import { getCollection } from 'astro:content';

import { compareNumericIds } from '@lib/utils';

const testimonies = (await getCollection('testimonies')).sort(compareNumericIds);
---

<section
    class="section"
    aria-label="Testimonies"
>
    <div class="shell testimonies__grid">
        <p
            class="eyebrow col-span-3 col-start-1"
            data-scroll
        >
            Testimonies
        </p>
        <figure
            class="testimonies__lead"
            data-scroll
        >
            <div
                class="testimonies__mark"
                aria-hidden="true"
            >
                &ldquo;
            </div>
            <blockquote class="testimonies__lead-quote">{testimonies[0].data.quote}&rdquo;</blockquote>
            <figcaption class="eyebrow">&mdash; {testimonies[0].data.journal}</figcaption>
        </figure>
        <figure
            class="col-span-8 col-start-5"
            data-scroll="right"
        >
            <blockquote class="testimonies__spread-quote">&ldquo;{testimonies[1].data.quote}&rdquo;</blockquote>
            <figcaption class="eyebrow">&mdash; {testimonies[1].data.journal}</figcaption>
        </figure>
    </div>
</section>

<style>
    .testimonies__grid {
        align-items: start;
        display: grid;
        gap: 24px;
        grid-template-columns: repeat(12, 1fr);
    }

    .testimonies__lead {
        grid-column: 4 / span 6;
        margin-bottom: 120px;
    }

    .testimonies__lead-quote {
        font-family: var(--font-display);
        font-size: clamp(20px, calc(17px + 0.94vw), 29px);
        font-style: italic;
        font-weight: 420;
        line-height: 1.4;
        margin-bottom: 28px;
        text-wrap: pretty;
    }

    .testimonies__mark {
        font-family: var(--font-display);
        font-size: 110px;
        line-height: 0.42;
        margin-bottom: 20px;
        text-indent: -6px;
    }

    .testimonies__spread-quote {
        color: var(--color-umber);
        column-gap: 32px;
        columns: 2;
        font-size: 17px;
        line-height: 1.7;
        margin-bottom: 28px;
        text-wrap: pretty;
    }

    @media (max-width: 1024px) {
        .testimonies__grid {
            display: block;
        }

        .testimonies__grid > * {
            margin-bottom: 40px;
        }

        .testimonies__grid > :last-child {
            margin-bottom: 0;
        }

        .testimonies__spread-quote {
            columns: 1;
        }
    }
</style>
